{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build:web"
  },
  "deploy": {
    "preDeployCommand": ["node --experimental-transform-types scripts/hosted-demo-provision.mjs ensure"],
    "startCommand": "npm --workspace @build-manager/web run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
